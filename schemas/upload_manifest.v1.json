{
  "$id": "https://github.com/SimSalabimse/open-shader-db/schemas/upload_manifest.v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Anonymized upload manifest (schema_version 1). No paths, usernames, IPs, hostnames, hardware ids, or full timestamps.",
  "properties": {
    "build_id": {
      "additionalProperties": false,
      "properties": {
        "exe_hash": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "game_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\x21-\\x2E\\x30-\\x39\\x3B-\\x5B\\x5D-\\x7E]{1,128}$",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[\\x21-\\x2E\\x30-\\x39\\x3B-\\x5B\\x5D-\\x7E]{1,128}$",
          "type": "string"
        }
      },
      "required": [
        "exe_hash",
        "game_id",
        "version"
      ],
      "type": "object"
    },
    "bytecode_hashes": {
      "items": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 400000,
      "type": "array",
      "uniqueItems": true
    },
    "client_version": {
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "collected_hour": {
      "description": "UTC hour boundary. Minutes and seconds are always 00.",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00Z$",
      "type": "string"
    },
    "description_hashes": {
      "items": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 150000,
      "type": "array",
      "uniqueItems": true
    },
    "ownership": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unchallenged"
            },
            "reason": {
              "const": "no_server_challenge"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "challenge": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "kind": {
              "const": "exe_binding_v1"
            },
            "response": {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "challenge",
            "kind",
            "response"
          ],
          "type": "object"
        }
      ]
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    }
  },
  "required": [
    "build_id",
    "bytecode_hashes",
    "client_version",
    "collected_hour",
    "description_hashes",
    "ownership",
    "schema_version"
  ],
  "title": "UploadManifest",
  "type": "object"
}
