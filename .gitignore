/dist/
/target/
*.exe
*.dll
*.so
*.dylib
*.pdb
*.ilk

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Language-specific

## C++
*.o
*.obj
*.a
*.lib
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

## Rust
/target/
**/*.rs.bk

## Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/

## Node.js (if used for tooling)
node_modules/
worker/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local data and secrets
/data/local/
/staging/
*.key
*.pem
secrets.json
.env
.env.local

# Logs
*.log
logs/

# Testing
/test-output/
/coverage/

# CI/CD
.github/workflows/*.tmp

# OS-specific
.DS_Store
Thumbs.db
desktop.ini

